# Salin file ini jadi .env lalu isi dengan API key kamu sendiri.
# JANGAN commit file .env ke GitHub!

# Gemini AI — analisis hama, chat, harga pasar, rekomendasi cuaca
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek — fallback AI jika Gemini limit/error
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenWeatherMap — data cuaca real-time (free tier: 1000 call/hari)
VITE_WEATHER_API_KEY=your_openweather_api_key_here

# URL aplikasi saat development
APP_URL=http://localhost:3000